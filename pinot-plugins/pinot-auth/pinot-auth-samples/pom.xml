<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>pinot-auth</artifactId>
    <groupId>org.apache.pinot</groupId>
    <version>1.5.1.3.3.6.6-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>
  <artifactId>pinot-auth-samples</artifactId>
  <name>Pinot Authentication Samples</name>
  <description>Sample OAuth 2.0 token handlers and token source to adapt for an identity provider the built-in handlers
    cannot express. Uses only the JDK and the authentication SPI, so the jar loads through the java handler type
    without extra dependencies.</description>
  <url>https://pinot.apache.org/</url>
  <properties>
    <pinot.root>${basedir}/../../..</pinot.root>
    <phase.prop>package</phase.prop>
  </properties>

  <dependencies>
    <!-- Provided by Pinot at runtime; the handler class loader exposes these packages to handler jars -->
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-auth-spi</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-spi</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Test only: the router loads the packed sample jar through the java handler type, as a deployment would -->
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-auth-oauth2</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Source archive that builds on its own (standalone-pom.xml), attached to the build for the release -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>standalone-source-archive</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/assembly/src.xml</descriptor>
              </descriptors>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
