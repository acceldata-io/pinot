<!--
  Build file for working on the samples outside the Pinot source tree. The source archive ships it as pom.xml:

    unzip pinot-auth-samples-<version>-src.zip && cd pinot-auth-samples
    mvn -Dpinot.version=<the Pinot version of your cluster> package

  Requires JDK 17 and access to a Maven repository that has the Pinot artifacts of that version (add it under
  <repositories> below or in ~/.m2/settings.xml). Rename groupId / artifactId / package when you adapt the code.
  The jar in target/ is what goes to <plugins dir>/pinot-auth-handlers/<handler name>/ on every Pinot host.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.pinot</groupId>
  <artifactId>pinot-auth-samples</artifactId>
  <version>${pinot.version}</version>
  <name>Pinot Authentication Samples (standalone)</name>

  <properties>
    <pinot.version>1.5.1.3.3.6.6-SNAPSHOT</pinot.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <slf4j.version>2.0.17</slf4j.version>
    <jsr305.version>3.0.2</jsr305.version>
    <testng.version>7.12.0</testng.version>
  </properties>

  <dependencies>
    <!-- Provided by Pinot at runtime: keep these provided so they are not packed into the handler jar -->
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-auth-spi</artifactId>
      <version>${pinot.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-spi</artifactId>
      <version>${pinot.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
      <version>${jsr305.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Test only -->
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-auth-oauth2</artifactId>
      <version>${pinot.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
  </build>
</project>
